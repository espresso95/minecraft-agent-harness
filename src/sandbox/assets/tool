#!/usr/bin/env python3
import json
import sys
from agent_tools import call

TOOLS_JSON = '/opt/harness/tools.json'

try:
    args = sys.argv[1:]
    if not args:
        raise ValueError('usage: tool <name> [json-args] | --list | --help <name>')
    if args[0] in ('--list', '--help'):
        with open(TOOLS_JSON) as file:
            tools = json.load(file)
        if args[0] == '--list':
            for tool in tools:
                print('%-22s %s' % (tool['name'], tool['description'][:110]))
        else:
            matches = [tool for tool in tools if len(args) == 2 and tool['name'] == args[1]]
            if not matches:
                raise ValueError('Unknown tool')
            print(json.dumps(matches[0], indent=1))
    else:
        print(json.dumps(call(args[0], json.loads(args[1]) if len(args) > 1 else {}), separators=(',', ':')))
except Exception as error:
    print(str(error), file=sys.stderr)
    sys.exit(1)
